---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign collections = site.collections | where_exp: 'collection', 'collection.output != false' %}
{% for collection in collections %}
  {% assign documents = collection.docs | where_exp: 'doc', 'doc.sitemap != false' %}
  {% for doc in documents %}
  <url><loc>{{ doc.canonical_path | default: doc.url | astra_canonical: site.url | xml_escape }}</loc></url>
  {% endfor %}
{% endfor %}
{% assign public_pages = site.html_pages | where_exp: 'item', 'item.sitemap != false' | where_exp: 'item', 'item.url != "/404.html"' %}
{% for item in public_pages %}
  <url><loc>{{ item.canonical_path | default: item.url | astra_canonical: site.url | xml_escape }}</loc></url>
{% endfor %}
</urlset>
