# Public control-panel configuration. These values are safe to name but must be
# supplied locally; do not commit real project URLs or keys to this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Browser-safe GitHub CMS configuration. The broker is responsible for the
# confidential GitHub App OAuth exchange; never put its client secret here.
GITHUB_APP_CLIENT_ID=
GITHUB_AUTH_BROKER_URL=
GITHUB_REPO_OWNER=Iyad-Ayoub
GITHUB_REPO_NAME=astra-team.github.io

# Never place a Supabase secret/service key, GitHub App client secret/private
# key, PAT, installation token, or GitHub publishing credential in
# this file, browser code, static-site configuration, or version control.
